{
  /*
   * FICHIER: destinations.json
   * DESCRIPTION: Base de données des destinations pour la galerie modale
   * 
   * Ce fichier contient toutes les informations sur les destinations spatiales.
   * Il est utilisé par la classe DestinationData pour charger les données de manière asynchrone.
   * 
   * STRUCTURE:
   * - destinations: tableau contenant chaque destination
   *   - id: identifiant unique (utilisé pour les sélecteurs CSS)
   *   - name: nom affiché de la destination
   *   - description: texte descriptif détaillé
   *   - image: chemin vers l'image de la planète
   *   - distance: distance depuis la Terre
   *   - travelTime: temps de voyage estimé
   * 
   * AVANTAGES du JSON:
   * 1. Séparation des données de la logique métier
   * 2. Facile à maintenir et à étendre
   * 3. Chargement asynchrone possible
   * 4. Format standard du web
   */
  "destinations": [
    {
      "id": "moon",
      "name": "MOON",
      "description": "See our planet as you've never seen it before. A perfect relaxing trip away to help regain perspective and come back refreshed. While you're there, take in some history by visiting the Luna 2 and Apollo 11 landing sites.",
      "image": "img/moon.png",
      "distance": "384,400 KM",
      "travelTime": "3 DAYS"
    },
    {
      "id": "mars",
      "name": "MARS",
      "description": "Don't forget to pack your hiking boots! You'll need them to tackle Olympus Mons, the tallest planetary mountain in our solar system. It's two and a half times the size of Everest!",
      "image": "img/mars.png",
      "distance": "225 MIL. KM",
      "travelTime": "9 MONTHS"
    },
    {
      "id": "europa",
      "name": "EUROPA",
      "description": "The smallest of the four Galilean moons orbiting Jupiter, Europa is a winter lover's dream. With an icy surface, it's perfect for ice skating, curling, hockey, or simple relaxation in your snug wintery cabin.",
      "image": "img/europa.png",
      "distance": "628 MIL. KM",
      "travelTime": "3 YEARS"
    },
    {
      "id": "titan",
      "name": "TITAN",
      "description": "The only moon known to have a dense atmosphere other than Earth, Titan is a home away from home (just a few hundred degrees colder!). As a bonus, you get striking views of the Rings of Saturn.",
      "image": "img/titan.png",
      "distance": "1.6 BIL. KM",
      "travelTime": "7 YEARS"
    }
  ]
}